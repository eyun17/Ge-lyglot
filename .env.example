# Copy to .env and fill in. .env is in .gitignore and must never be committed.
# Command-line options (--provider, --model) override these values.

# Which LLM to use: openai (API, costs money) | anthropic (API) | ollama (local, free)
LLM_PROVIDER=openai

# OpenAI API
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=low

# Local models with Ollama (https://ollama.com): `ollama pull qwen3:8b`, then --provider ollama
OLLAMA_MODEL=qwen3:8b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384
