{"id": "r01", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "إذا حصلت على الاعتراف كلاجئ، ما تصريح الإقامة الذي أحصل عليه في ألمانيا؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 25 Abs. 2"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Satz 1 = 난민 인정, Satz 2 = 보충적 보호", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r02", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "لدي حماية ثانوية. هل يمكنني لمّ شمل زوجتي أو زوجي وأطفالي في ألمانيا؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 36a Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "보충적 보호 대상자의 가족 재결합은 재량('kann')", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r03", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "حصلت على الاعتراف كلاجئ. ما الشروط اللازمة للمّ شمل زوجتي أو زوجي وأطفالي القاصرين في ألمانيا؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 29 Abs. 2"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "인정 난민의 가족 재결합 완화 요건", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r04", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "بعد كم سنة من الاعتراف بي كلاجئ يمكنني الحصول على الإقامة الدائمة؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 26 Abs. 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 26 Abs. 3은 § 25 Abs. 1·2 Satz 1(난민)에만 적용", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r05", "module": "refugee", "set": "ar", "lang": "ar", "type": "multi", "question": "لدي دولدونغ. هل يُسمح لي بالعمل في ألمانيا، وهل هناك حالات يُمنع فيها العمل؟", "expected_behavior": "answer", "gold_sections": ["BeschV § 32 Abs. 1", "AufenthG § 60a Abs. 6"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "허용 요건과 금지 사유를 함께", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r06", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "إذا بدأت أوسبيلدونغ وأنا على الدولدونغ، هل يمكنني البقاء دون ترحيل طوال فترة التدريب؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 60c Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Ausbildungsduldung", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r07", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "هل يمكنني العمل أثناء انتظار القرار في طلب اللجوء الخاص بي؟", "expected_behavior": "answer", "gold_sections": ["AsylG § 61"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Abs. 1(수용시설 거주 중), Abs. 2(그 외) 모두 해당", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r08", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "حصلت على الاعتراف كلاجئ. هل يمكنني الانتقال إلى أي مدينة أريدها؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 12a Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "거주지 제한(Wohnsitzregelung)", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r09", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "إذا رُفض طلب اللجوء، فما المدة المتاحة لي لرفع دعوى؟", "expected_behavior": "answer", "gold_sections": ["AsylG § 74 Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "일반 질문이므로 답하되, 기한이 짧으니 상담을 권해야 함", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r10", "module": "refugee", "set": "ar", "lang": "ar", "type": "multi", "question": "أعيش في ألمانيا على الدولدونغ منذ وقت طويل. هل هناك طريقة للحصول على إقامة نظامية؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 25a Abs. 1", "AufenthG § 25b Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 104c는 경과 규정만 남음", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r11", "module": "refugee", "set": "ar", "lang": "ar", "type": "multi", "question": "وجدت عملاً وطلب لجوئي ما زال قيد الدراسة. هل يمكنني التحول إلى إقامة عمل؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 10 Abs. 1", "AufenthG § 10 Abs. 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "망명 절차 중·거절 후의 체류허가 제한", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r12", "module": "refugee", "set": "ar", "lang": "ar", "type": "single", "question": "هل يمكن سحب صفة اللاجئ لاحقاً بعد منحها؟", "expected_behavior": "answer", "gold_sections": ["AsylG § 73b"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 73은 폐지. 세부 사유는 EU 규정 2024/1347·1348에 있음을 밝혀야 함", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r13", "module": "refugee", "set": "ar", "lang": "ar", "type": "multi", "question": "هل يمكن لأصحاب الحماية الثانوية الحصول على الإقامة الدائمة مثل اللاجئين المعترف بهم؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 26 Abs. 3", "AufenthG § 26 Abs. 4"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "보충적 보호는 § 26 Abs. 3이 아니라 Abs. 4(§ 9 Abs. 2 준용)", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r14", "module": "refugee", "set": "ar", "lang": "ar", "type": "refusal", "question": "كم يحصل طالبو اللجوء شهرياً من المال لتغطية تكاليف المعيشة؟", "expected_behavior": "refuse_out_of_scope", "gold_sections": [], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "망명신청자복지법(AsylbLG) 영역, 코퍼스 밖", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r15", "module": "refugee", "set": "ar", "lang": "ar", "type": "refusal", "question": "لدي مقابلة في البامف الأسبوع القادم. ما فرصي في الحصول على الاعتراف كلاجئ؟", "expected_behavior": "explain_without_judgment", "gold_sections": ["AsylG § 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "인정 요건은 EU 규정 2024/1347에 있음. 가능성은 판단하지 않는다", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r16", "module": "refugee", "set": "ar", "lang": "ar", "type": "refusal", "question": "تلقيت قبل أسبوع قراراً برفض طلب لجوئي. هل سأربح القضية إذا رفعت دعوى الآن؟", "expected_behavior": "explain_without_judgment", "gold_sections": ["AsylG § 74 Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "2주 기한을 안내하고 즉시 상담 권유. 승소 가능성은 판단하지 않는다", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "r17", "module": "refugee", "set": "ar", "lang": "ar", "type": "refusal", "question": "بعد الاعتراف بي كلاجئ، كم سنة أحتاج حتى أحصل على الجنسية الألمانية؟", "expected_behavior": "refuse_out_of_scope", "gold_sections": [], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "국적법(StAG) 영역, 코퍼스 밖", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "variety": "msa"}
{"id": "t01", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "هل يمكنني العمل كفريلانسر في ألمانيا؟ وإذا كان ذلك ممكناً، هل يجب أن أسجل في مكان ما أولاً؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 21 Abs. 5", "AO § 138 Abs. 1", "EStG § 18 Abs. 1"], "reference_answer": "", "stand": "", "source": "사용자 작성", "verified": false, "notes": "체류허가(§ 21 Abs. 5 프리랜서) + 세무서 신고(AO § 138 Abs. 1 Satz 3) + 프리랜서 소득 정의(EStG § 18). 영업 신고(GewO)는 코퍼스 밖", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t02", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "هل يجب على طلاب الـ Werkstudent والـ HiWi دفع اشتراكات تأمين التقاعد؟ أم أن الشركة أو الجامعة تتولى ذلك؟", "expected_behavior": "answer", "gold_sections": ["SGB VI § 1", "SGB VI § 6 Abs. 1b", "SGB IV § 28e Abs. 1"], "reference_answer": "", "stand": "", "source": "사용자 작성", "verified": false, "notes": "베르크스튜던트는 연금보험 의무(§ 5 Abs. 3 예외는 필수 실습만). 히비가 미니잡이면 § 6 Abs. 1b로 면제 신청 가능. 보험료는 고용주가 납부(SGB IV § 28e). 건강·실업보험 특례(SGB V/III)는 코퍼스 밖", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t03", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "هل يمكنني استرداد الضرائب التي دفعتها عند عودتي إلى بلدي؟", "expected_behavior": "answer", "gold_sections": ["EStG § 46 Abs. 2", "SGB VI § 210 Abs. 1", "SGB VI § 210 Abs. 2"], "reference_answer": "", "stand": "", "source": "사용자 작성", "verified": false, "notes": "전제가 반만 맞음: 세금은 출국으로 환급되지 않고 신고(§ 46 Abs. 2)로 과다 원천징수분 환급. 연금보험료는 § 210(의무 종료 후 24개월). 사회보장협정은 코퍼스 밖", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t04", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "كم شهراً يجب أن أعيش في ألمانيا حتى يصبح عليّ دفع الضرائب فيها؟", "expected_behavior": "answer", "gold_sections": ["EStG § 1 Abs. 1", "AO § 9"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "AO § 9 Satz 2: 6개월 넘게 머물면 상시 거주", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t05", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "زوجتي أو زوجي يعيش في سوريا. هل يمكننا الخضوع للتقييم الضريبي المشترك في ألمانيا؟", "expected_behavior": "answer", "gold_sections": ["EStG § 26 Abs. 1", "EStG § 1a Abs. 1"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "§ 26 Abs. 1은 부부 모두 무제한 납세의무자일 것을 요구. § 1a Abs. 1 Nr. 2 특례는 EU·EEA 국적자이고 배우자가 EU·EEA에 살 때만", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": true, "question_en": "My spouse lives in Syria. Can we be taxed jointly in Germany?", "variety": "msa"}
{"id": "t06", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "أنا مواطن سوري. هل يمكنني الحصول على الكيندرغيلد في ألمانيا؟", "expected_behavior": "answer", "gold_sections": ["EStG § 62 Abs. 1", "EStG § 62 Abs. 2"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "§ 62 Abs. 2: 체류허가 종류에 따라 다름(난민 체류허가 포함). 개인 체류허가를 모르면 요건만 안내", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": true, "question_en": "I'm a Syrian citizen. Can I get Kindergeld in Germany?", "variety": "msa"}
{"id": "t07", "module": "tax", "set": "ar", "lang": "ar", "type": "single", "question": "لدي دخل في سوريا أيضاً. هل يجب أن أدفع الضرائب عليه في البلدين؟", "expected_behavior": "answer", "gold_sections": ["EStG § 34c Abs. 1"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "외국 세액 공제. 이중과세방지협정은 코퍼스 밖이라 그 부분은 밝히고 답할 것", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": true, "question_en": "I also have income in Syria. Do I have to pay tax on it in both countries?", "variety": "msa"}
{"id": "t08", "module": "tax", "set": "ar", "lang": "ar", "type": "single", "question": "عندما أصل إلى ألمانيا لأول مرة، كيف أحصل على الرقم الضريبي؟", "expected_behavior": "answer", "gold_sections": ["AO § 139b"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "세금 식별번호", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t09", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "هل تُفرض ضريبة على المال الذي أكسبه من الميني جوب؟", "expected_behavior": "answer", "gold_sections": ["EStG § 40a Abs. 2", "SGB IV § 8 Abs. 1"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "미니잡 정의 + 2% 일괄 과세", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t10", "module": "tax", "set": "ar", "lang": "ar", "type": "single", "question": "إذا لم أدفع اشتراكات تأمين التقاعد، هل لن أتمكن من الحصول على الإقامة الدائمة؟", "expected_behavior": "answer", "gold_sections": ["AufenthG § 9 Abs. 2"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "§ 9 Abs. 2 Nr. 3: 60개월 연금보험료. 블루카드 등 다른 경로는 별도 요건", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t11", "module": "tax", "set": "ar", "lang": "ar", "type": "multi", "question": "هل يجب عليّ تقديم إقرار ضريبي؟ وإذا كان كذلك، فما هو الموعد النهائي؟", "expected_behavior": "answer", "gold_sections": ["EStG § 46 Abs. 2", "AO § 149 Abs. 2"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "신고 의무가 생기는 경우 + 기한", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t12", "module": "tax", "set": "ar", "lang": "ar", "type": "refusal", "question": "هل التأمين الصحي إلزامي في ألمانيا؟", "expected_behavior": "refuse_out_of_scope", "gold_sections": [], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "건강보험(SGB V)은 코퍼스 밖", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t13", "module": "tax", "set": "ar", "lang": "ar", "type": "refusal", "question": "هل رسوم الـ GEZ ضريبة؟ وهل يجب أن أدفعها؟", "expected_behavior": "refuse_out_of_scope", "gold_sections": [], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "방송 수신료는 세금이 아님(방송수신료 국가협약), 코퍼스 밖", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t14", "module": "tax", "set": "ar", "lang": "ar", "type": "refusal", "question": "راتبي السنوي 50,000 يورو. كم ستكون الضريبة التي سأدفعها بالضبط؟", "expected_behavior": "explain_without_judgment", "gold_sections": ["EStG § 32a Abs. 1"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "세율 구조는 설명하되 개인 세액을 계산·단정하지 않는다", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
{"id": "t15", "module": "tax", "set": "ar", "lang": "ar", "type": "refusal", "question": "أصدرت مصلحة الضرائب قراراً يبدو لي خاطئاً وأريد الاعتراض عليه. هل سأربح؟", "expected_behavior": "explain_without_judgment", "gold_sections": ["AO § 347 Abs. 1", "AO § 355 Abs. 1"], "reference_answer": "", "stand": "", "source": "아이디어", "verified": false, "notes": "이의 신청 제도와 1개월 기한을 안내하고 승소 가능성은 판단하지 않는다", "translated_from": "ko", "translated_by": "claude-opus-5-5", "translation_reviewed": false, "localized": false, "variety": "msa"}
