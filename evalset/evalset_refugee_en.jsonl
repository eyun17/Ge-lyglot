{"id": "r01", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "If I'm recognised as a refugee, what residence permit do I get in Germany?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 25 Abs. 2"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Satz 1 = 난민 인정, Satz 2 = 보충적 보호", "translated_from": "ko", "translation_reviewed": false}
{"id": "r02", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "I have subsidiary protection. Can I bring my spouse and children to Germany?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 36a Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "보충적 보호 대상자의 가족 재결합은 재량('kann')", "translated_from": "ko", "translation_reviewed": false}
{"id": "r03", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "I've been recognised as a refugee. What do I need to bring my spouse and minor children to Germany?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 29 Abs. 2"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "인정 난민의 가족 재결합 완화 요건", "translated_from": "ko", "translation_reviewed": false}
{"id": "r04", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "How many years after being recognised as a refugee can I get permanent residence?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 26 Abs. 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 26 Abs. 3은 § 25 Abs. 1·2 Satz 1(난민)에만 적용", "translated_from": "ko", "translation_reviewed": false}
{"id": "r05", "module": "refugee", "type": "multi", "lang": "en", "set": "en", "question": "I have a Duldung. Am I allowed to work in Germany, and are there cases where work is not allowed?", "expected_behavior": "answer", "gold_sections": ["BeschV § 32 Abs. 1", "AufenthG § 60a Abs. 6"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "허용 요건과 금지 사유를 함께", "translated_from": "ko", "translation_reviewed": false}
{"id": "r06", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "If I start an Ausbildung while I have a Duldung, can I stay without being deported during the training?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 60c Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Ausbildungsduldung", "translated_from": "ko", "translation_reviewed": false}
{"id": "r07", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "Can I work while I'm waiting for the decision on my asylum application?", "expected_behavior": "answer", "gold_sections": ["AsylG § 61"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Abs. 1(수용시설 거주 중), Abs. 2(그 외) 모두 해당", "translated_from": "ko", "translation_reviewed": false}
{"id": "r08", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "I've been recognised as a refugee. Can I move to any city I want?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 12a Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "거주지 제한(Wohnsitzregelung)", "translated_from": "ko", "translation_reviewed": false}
{"id": "r09", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "If my asylum application is rejected, how long do I have to file a lawsuit?", "expected_behavior": "answer", "gold_sections": ["AsylG § 74 Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "일반 질문이므로 답하되, 기한이 짧으니 상담을 권해야 함", "translated_from": "ko", "translation_reviewed": false}
{"id": "r10", "module": "refugee", "type": "multi", "lang": "en", "set": "en", "question": "I've lived in Germany on a Duldung for a long time. Is there a way to get a proper residence permit?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 25a Abs. 1", "AufenthG § 25b Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 104c는 경과 규정만 남음", "translated_from": "ko", "translation_reviewed": false}
{"id": "r11", "module": "refugee", "type": "multi", "lang": "en", "set": "en", "question": "I found a job while my asylum application is still pending. Can I switch to a work residence permit?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 10 Abs. 1", "AufenthG § 10 Abs. 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "망명 절차 중·거절 후의 체류허가 제한", "translated_from": "ko", "translation_reviewed": false}
{"id": "r12", "module": "refugee", "type": "single", "lang": "en", "set": "en", "question": "Can refugee status be taken away later once it has been granted?", "expected_behavior": "answer", "gold_sections": ["AsylG § 73b"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 73은 폐지. 세부 사유는 EU 규정 2024/1347·1348에 있음을 밝혀야 함", "translated_from": "ko", "translation_reviewed": false}
{"id": "r13", "module": "refugee", "type": "multi", "lang": "en", "set": "en", "question": "Can people with subsidiary protection get permanent residence the same way as recognised refugees?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 26 Abs. 3", "AufenthG § 26 Abs. 4"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "보충적 보호는 § 26 Abs. 3이 아니라 Abs. 4(§ 9 Abs. 2 준용)", "translated_from": "ko", "translation_reviewed": false}
{"id": "r14", "module": "refugee", "type": "refusal", "lang": "en", "set": "en", "question": "How much money do asylum seekers receive per month for living costs?", "expected_behavior": "refuse_out_of_scope", "gold_sections": [], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "망명신청자복지법(AsylbLG) 영역, 코퍼스 밖", "translated_from": "ko", "translation_reviewed": false}
{"id": "r15", "module": "refugee", "type": "refusal", "lang": "en", "set": "en", "question": "My BAMF interview is next week. What are my chances of being recognised as a refugee?", "expected_behavior": "explain_without_judgment", "gold_sections": ["AsylG § 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "인정 요건은 EU 규정 2024/1347에 있음. 가능성은 판단하지 않는다", "translated_from": "ko", "translation_reviewed": false}
{"id": "r16", "module": "refugee", "type": "refusal", "lang": "en", "set": "en", "question": "I received a decision rejecting my asylum application a week ago. Would I win if I sued now?", "expected_behavior": "explain_without_judgment", "gold_sections": ["AsylG § 74 Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "2주 기한을 안내하고 즉시 상담 권유. 승소 가능성은 판단하지 않는다", "translated_from": "ko", "translation_reviewed": false}
{"id": "r17", "module": "refugee", "type": "refusal", "lang": "en", "set": "en", "question": "After being recognised as a refugee, how many years until I can get German citizenship?", "expected_behavior": "refuse_out_of_scope", "gold_sections": [], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "국적법(StAG) 영역, 코퍼스 밖", "translated_from": "ko", "translation_reviewed": false}
