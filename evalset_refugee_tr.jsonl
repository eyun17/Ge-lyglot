{"id": "r01", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "Mülteci olarak tanınırsam Almanya'da hangi oturum iznini alırım?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 25 Abs. 2"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Satz 1 = 난민 인정, Satz 2 = 보충적 보호", "translated_from": "ko", "translation_reviewed": false}
{"id": "r02", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "İkincil koruma statüm var. Eşimi ve çocuklarımı Almanya'ya getirebilir miyim?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 36a Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "보충적 보호 대상자의 가족 재결합은 재량('kann')", "translated_from": "ko", "translation_reviewed": false}
{"id": "r03", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "Mülteci olarak tanındım. Eşimi ve reşit olmayan çocuklarımı Almanya'ya getirmek için hangi koşullar gerekiyor?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 29 Abs. 2"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "인정 난민의 가족 재결합 완화 요건", "translated_from": "ko", "translation_reviewed": false}
{"id": "r04", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "Mülteci olarak tanındıktan kaç yıl sonra süresiz oturum izni alabilirim?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 26 Abs. 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 26 Abs. 3은 § 25 Abs. 1·2 Satz 1(난민)에만 적용", "translated_from": "ko", "translation_reviewed": false}
{"id": "r05", "module": "refugee", "type": "multi", "lang": "tr", "set": "tr-TR", "question": "Duldung'um var. Almanya'da çalışabilir miyim, çalışmanın yasak olduğu durumlar var mı?", "expected_behavior": "answer", "gold_sections": ["BeschV § 32 Abs. 1", "AufenthG § 60a Abs. 6"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "허용 요건과 금지 사유를 함께", "translated_from": "ko", "translation_reviewed": false}
{"id": "r06", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "Duldung'la Ausbildung'a başlarsam eğitim süresince sınır dışı edilmeden kalabilir miyim?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 60c Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Ausbildungsduldung", "translated_from": "ko", "translation_reviewed": false}
{"id": "r07", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "İltica başvurumun sonucunu beklerken çalışabilir miyim?", "expected_behavior": "answer", "gold_sections": ["AsylG § 61"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "Abs. 1(수용시설 거주 중), Abs. 2(그 외) 모두 해당", "translated_from": "ko", "translation_reviewed": false}
{"id": "r08", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "Mülteci olarak tanındım. İstediğim şehre taşınabilir miyim?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 12a Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "거주지 제한(Wohnsitzregelung)", "translated_from": "ko", "translation_reviewed": false}
{"id": "r09", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "İltica başvurum reddedilirse ne kadar süre içinde dava açmam gerekir?", "expected_behavior": "answer", "gold_sections": ["AsylG § 74 Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "일반 질문이므로 답하되, 기한이 짧으니 상담을 권해야 함", "translated_from": "ko", "translation_reviewed": false}
{"id": "r10", "module": "refugee", "type": "multi", "lang": "tr", "set": "tr-TR", "question": "Uzun süredir Almanya'da Duldung'la yaşıyorum. Düzgün bir oturum iznine geçmenin bir yolu var mı?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 25a Abs. 1", "AufenthG § 25b Abs. 1"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 104c는 경과 규정만 남음", "translated_from": "ko", "translation_reviewed": false}
{"id": "r11", "module": "refugee", "type": "multi", "lang": "tr", "set": "tr-TR", "question": "İltica başvurum devam ederken bir iş buldum. Çalışma amaçlı oturum iznine geçebilir miyim?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 10 Abs. 1", "AufenthG § 10 Abs. 3"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "망명 절차 중·거절 후의 체류허가 제한", "translated_from": "ko", "translation_reviewed": false}
{"id": "r12", "module": "refugee", "type": "single", "lang": "tr", "set": "tr-TR", "question": "Verilen mülteci statüsü daha sonra geri alınabilir mi?", "expected_behavior": "answer", "gold_sections": ["AsylG § 73b"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "§ 73은 폐지. 세부 사유는 EU 규정 2024/1347·1348에 있음을 밝혀야 함", "translated_from": "ko", "translation_reviewed": false}
{"id": "r13", "module": "refugee", "type": "multi", "lang": "tr", "set": "tr-TR", "question": "İkincil koruma statüsü olanlar da tanınmış mülteciler gibi süresiz oturum izni alabilir mi?", "expected_behavior": "answer", "gold_sections": ["AufenthG § 26 Abs. 3", "AufenthG § 26 Abs. 4"], "reference_answer": "", "stand": "", "source": "직접 작성", "verified": false, "notes": "보충적 보호는 § 26 Abs. 3이 아니라 Abs. 4(§ 9 Abs. 2 준용)", "translated_from": "ko", "translation_reviewed": false}
